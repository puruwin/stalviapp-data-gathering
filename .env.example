# Copia este archivo a .env y ajusta los valores.

# --- Base de datos (desarrollo local con docker-compose) ---
# Debe coincidir con los valores de docker-compose.yml.
# DATABASE_URL: owner (superusuario) — lo usa el scraper. Salta la RLS.
DATABASE_URL=postgresql://stalvi:stalvi@localhost:5432/stalvi
# APP_DATABASE_URL: rol de aplicación (no superusuario) — lo usará la app (F4).
# La RLS SÍ se aplica con este rol. Se crea en db/migrations/0003_users.sql.
APP_DATABASE_URL=postgresql://app_user:app_user@localhost:5432/stalvi

# --- API (F4) ---
# Secreto para firmar los JWT que emite el API (api/). Cambiar en producción.
API_JWT_SECRET=dev-insecure-secret-cambiar-en-prod
# API_JWT_TTL_HOURS=168   # validez del token (por defecto 7 días)

# --- Supabase (cloud, se usará a partir de F3 para Auth) ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=
